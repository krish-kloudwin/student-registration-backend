# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to Git.

# PostgreSQL connection string
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://student_app:24164044@localhost:5432/student_registration

# Comma-separated list of origins allowed to call this API (CORS)
CORS_ORIGINS=http://localhost:3000

# Secret key used to sign JWTs. MUST be changed to a long random string
# for any real deployment - generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_dev_only_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
